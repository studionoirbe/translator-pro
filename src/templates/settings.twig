{% extends "_layouts/cp" %}
{% import "_includes/forms.twig" as forms %}

{% set selectedSubnavItem = 'settings' %}
{% set title = "Settings"|t('translingua') %}

{% block content %}
    <form method="post" accept-charset="UTF-8" id="tp-settings-form">
        {{ csrfInput() }}
        {{ actionInput('translingua/settings/save') }}
        {{ redirectInput('translingua/settings') }}

        <div class="pane" style="margin-bottom: 24px;">
            <h2>{{ "Edition"|t('translingua') }}</h2>
            {% if isPlus %}
                <p><span class="success">{{ "Plus"|t('translingua') }}</span> — {{ "AI translations are enabled."|t('translingua') }}</p>
            {% else %}
                <p>
                    <span class="light">{{ "Lite"|t('translingua') }}</span> —
                    {{ "Static translations only. Upgrade to Plus for AI translations, per-field translate buttons and batch runs."|t('translingua') }}
                </p>
            {% endif %}
            {# The handle, not just the label: if the Plugin Store ever installs
               an edition other than the one that was picked, this is where it
               shows. #}
            <p class="light smalltext">
                {{ "Active edition handle:"|t('translingua') }} <code>{{ edition }}</code>
            </p>
            <p class="light smalltext">
                {{ "Locally you can switch editions with:"|t('translingua') }}
                <code>php craft translingua/license/set-edition {{ isPlus ? 'lite' : 'plus' }}</code>
            </p>
            {% if unknownLicensedEdition %}
                <p class="error smalltext">
                    {{ "The licence is for an edition this build doesn’t define: “{edition}”. Until the Plugin Store listing uses the handles above, installing and switching editions will land on the wrong one."|t('translingua', { edition: unknownLicensedEdition }) }}
                </p>
            {% endif %}
        </div>

        <h2>{{ "AI provider"|t('translingua') }}</h2>

        {% if not isPlus %}
            <div class="pane" style="margin-bottom: 20px;">
                <p class="light">
                    {{ "These settings are kept, but nothing below does anything on Lite. They take effect the moment the install switches to Plus."|t('translingua') }}
                </p>
            </div>
        {% endif %}

        {% if isPlus %}
            <div class="pane" style="margin-bottom: 20px;">
                {% if verified %}
                    <p>
                        <span class="success">{{ "Connection verified"|t('translingua') }}</span> —
                        {{ "the translate buttons are active throughout the control panel."|t('translingua') }}
                    </p>
                {% else %}
                    <p>
                        <span class="error">{{ "Not connected"|t('translingua') }}</span> —
                        {{ "the translate buttons stay hidden until a request to the provider succeeds."|t('translingua') }}
                    </p>
                    {% if verificationError %}
                        <p class="error smalltext">{{ verificationError }}</p>
                    {% endif %}
                {% endif %}
            </div>
        {% endif %}

        {{ forms.selectField({
            label: "Provider"|t('translingua'),
            id: 'provider',
            name: 'settings[provider]',
            options: providerOptions,
            value: settings.provider,
            errors: settings.getErrors('provider'),
            disabled: 'provider' in overrides|keys,
        }) }}

        {{ forms.autosuggestField({
            label: "API key"|t('translingua'),
            instructions: "Stored in project config, so use an environment variable in anything you commit."|t('translingua'),
            id: 'apiKey',
            name: 'settings[apiKey]',
            value: settings.apiKey,
            suggestEnvVars: true,
            errors: settings.getErrors('apiKey'),
            disabled: 'apiKey' in overrides|keys,
        }) }}

        {{ forms.textField({
            label: "Model"|t('translingua'),
            instructions: "Only used by the LLM providers. Leave blank for the provider’s default."|t('translingua'),
            id: 'model',
            name: 'settings[model]',
            value: settings.model,
            placeholder: 'gpt-4o-mini / claude-sonnet-5 / gemini-2.0-flash',
            errors: settings.getErrors('model'),
        }) }}

        {{ forms.lightswitchField({
            label: "Use the DeepL free API"|t('translingua'),
            instructions: "Only needed if your key doesn’t end in :fx — those are detected automatically."|t('translingua'),
            name: 'settings[deeplFreeApi]',
            on: settings.deeplFreeApi,
        }) }}

        {{ forms.textareaField({
            label: "Prompt context"|t('translingua'),
            instructions: "Extra guidance for the LLM providers — tone of voice, terms to leave untranslated, formality."|t('translingua'),
            name: 'settings[promptContext]',
            value: settings.promptContext,
            rows: 4,
        }) }}

        <div class="field">
            <div class="input">
                {# Disabled rather than hidden on Lite: a button that always
                   answers "not on this edition" is just a slower way of saying
                   what the note above already says. #}
                <button type="button" class="btn{{ isPlus ? '' : ' disabled' }}" id="tp-test"{{ isPlus ? '' : ' disabled' }}>{{ "Test connection"|t('translingua') }}</button>
                <span id="tp-test-result" class="light" style="margin-inline-start: 8px;">{% if not isPlus %}{{ "Available on Plus."|t('translingua') }}{% endif %}</span>
            </div>
        </div>

        {% if usage %}
            <p class="light">
                {{ "DeepL usage: {used} characters"|t('translingua', { used: usage.used|number_format }) }}
                {%- if usage.limit %} / {{ usage.limit|number_format }}{% endif %}
            </p>
        {% endif %}

        <hr>

        <h2>{{ "Control panel buttons"|t('translingua') }}</h2>

        {{ forms.lightswitchField({
            label: "Show a translate button on each field"|t('translingua'),
            name: 'settings[enableFieldButtons]',
            on: settings.enableFieldButtons,
        }) }}

        {{ forms.lightswitchField({
            label: "Show a “Translate page” button next to Save"|t('translingua'),
            name: 'settings[enablePageButton]',
            on: settings.enablePageButton,
        }) }}

        {{ forms.lightswitchField({
            label: "Overwrite fields that already have content"|t('translingua'),
            instructions: "Applies to batch runs. The per-field button always replaces what you point it at."|t('translingua'),
            name: 'settings[overwriteExisting]',
            on: settings.overwriteExisting,
        }) }}

        {{ forms.editableTableField({
            label: "Never show any translate button on"|t('translingua'),
            instructions: "Control panel paths that get no translate buttons at all, without the /admin prefix. A path also covers everything below it, so “settings” covers creating a field."|t('translingua'),
            id: 'fieldButtonExcludedPaths',
            name: 'settings[fieldButtonExcludedPaths]',
            cols: {
                value: { heading: "Path"|t('translingua'), type: 'singleline' },
            },
            rows: settings.fieldButtonExcludedPaths|map(p => { value: p }),
            addRowLabel: "Add a path"|t('translingua'),
            allowAdd: true,
            allowDelete: true,
            allowReorder: true,
        }) }}

        {{ forms.editableTableField({
            label: "Show the page button on"|t('translingua'),
            instructions: "Control panel paths where the “Translate page” button may appear, without the /admin prefix. A * matches one segment, and a path also covers everything below it. Per-field buttons are unaffected."|t('translingua'),
            id: 'pageButtonPaths',
            name: 'settings[pageButtonPaths]',
            cols: {
                value: { heading: "Path"|t('translingua'), type: 'singleline' },
            },
            rows: settings.pageButtonPaths|map(p => { value: p }),
            addRowLabel: "Add a path"|t('translingua'),
            allowAdd: true,
            allowDelete: true,
            allowReorder: true,
        }) }}

        {{ forms.editableTableField({
            label: "Never translate fields matching"|t('translingua'),
            instructions: "Inputs whose name or id contains one of these fragments are left alone."|t('translingua'),
            id: 'excludedFieldPatterns',
            name: 'settings[excludedFieldPatterns]',
            cols: {
                value: { heading: "Fragment"|t('translingua'), type: 'singleline' },
            },
            rows: settings.excludedFieldPatterns|map(p => { value: p }),
            addRowLabel: "Add a fragment"|t('translingua'),
            allowAdd: true,
            allowDelete: true,
            allowReorder: true,
        }) }}

        <hr>

        <h2>{{ "Batch translations"|t('translingua') }}</h2>

        {{ forms.textField({
            label: "Strings per request"|t('translingua'),
            instructions: "How many strings are sent to the provider at once."|t('translingua'),
            name: 'settings[batchSize]',
            value: settings.batchSize,
            size: 5,
            type: 'number',
            errors: settings.getErrors('batchSize'),
        }) }}

        {{ forms.lightswitchField({
            label: "Create a revision before translating"|t('translingua'),
            instructions: "Lets an editor roll back a batch run from the element’s revision menu."|t('translingua'),
            name: 'settings[createRevisions]',
            on: settings.createRevisions,
        }) }}

        <hr>

        <h2>{{ "Template scanning"|t('translingua') }}</h2>

        {{ forms.editableTableField({
            label: "Extra directories to scan"|t('translingua'),
            instructions: "Craft aliases are allowed, e.g. @root/somewhere."|t('translingua'),
            id: 'extraScanPaths',
            name: 'settings[extraScanPaths]',
            cols: {
                value: { heading: "Path"|t('translingua'), type: 'singleline' },
            },
            rows: settings.extraScanPaths|map(p => { value: p }),
            addRowLabel: "Add a directory"|t('translingua'),
            allowAdd: true,
            allowDelete: true,
            allowReorder: true,
        }) }}

        {{ forms.editableTableField({
            label: "File extensions"|t('translingua'),
            id: 'scanExtensions',
            name: 'settings[scanExtensions]',
            cols: {
                value: { heading: "Extension"|t('translingua'), type: 'singleline' },
            },
            rows: settings.scanExtensions|map(e => { value: e }),
            addRowLabel: "Add an extension"|t('translingua'),
            allowAdd: true,
            allowDelete: true,
            allowReorder: true,
        }) }}

        <div class="buttons">
            <button type="submit" class="btn submit">{{ "Save"|t('translingua') }}</button>
        </div>
    </form>
{% endblock %}

{% js %}
document.getElementById('tp-test').addEventListener('click', function () {
    if (this.disabled) {
        return;
    }

    var button = this;
    var result = document.getElementById('tp-test-result');
    var form = document.getElementById('tp-settings-form');

    button.disabled = true;
    result.textContent = {{ "Testing…"|t('translingua')|json_encode|raw }};
    result.className = 'light';

    Craft.sendActionRequest('POST', 'translingua/settings/test-connection', {
        data: {
            settings: {
                provider: form.querySelector('[name="settings[provider]"]').value,
                apiKey: form.querySelector('[name="settings[apiKey]"]').value,
                model: form.querySelector('[name="settings[model]"]').value,
                deeplFreeApi: form.querySelector('[name="settings[deeplFreeApi]"]').value
            }
        }
    }).then(function (response) {
        result.textContent = response.data.message;
        result.className = 'success';
    }).catch(function (error) {
        result.textContent = (error.response && error.response.data && error.response.data.message)
            || {{ "Connection failed."|t('translingua')|json_encode|raw }};
        result.className = 'error';
    }).then(function () {
        button.disabled = false;
    });
});
{% endjs %}
