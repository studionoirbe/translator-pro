{% extends "_layouts/cp" %}
{% import "_includes/forms.twig" as forms %}

{% set selectedSubnavItem = 'static' %}
{% set title = "Static translations"|t('translator-pro') %}

{% block actionButton %}
    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('translator-pro/static/rescan') }}
        {{ redirectInput('translator-pro/static') }}
        <button type="submit" class="btn">{{ "Rescan templates"|t('translator-pro') }}</button>
    </form>
{% endblock %}

{% block content %}
    <p class="light">
        {{ "Translations are written to {path}. Craft loads that folder on top of each plugin’s own language files, so nothing inside vendor/ is ever touched."|t('translator-pro', {
            path: '<code>translations/{locale}/{category}.php</code>'
        })|raw }}
    </p>

    {% if sources is empty %}
        <p>{{ "No translation sources found."|t('translator-pro') }}</p>
    {% else %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ "Source"|t('translator-pro') }}</th>
                    <th scope="col">{{ "Category"|t('translator-pro') }}</th>
                    <th scope="col">{{ "Strings"|t('translator-pro') }}</th>
                    {% for locale, label in locales %}
                        <th scope="col">{{ locale }}</th>
                    {% endfor %}
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                {% for source in sources %}
                    {% set typeLabel = {
                        site: "Templates"|t('translator-pro'),
                        app: "Craft"|t('translator-pro'),
                        plugin: "Plugin"|t('translator-pro'),
                    }[source.type] ?? source.type %}
                    <tr>
                        <th scope="row">
                            <a href="{{ source.cpEditUrl }}">{{ source.name }}</a>
                            <span class="light">— {{ typeLabel }}</span>
                        </th>
                        <td><code>{{ source.category }}</code></td>
                        <td>{{ source.stringCount }}</td>
                        {% for locale, label in locales %}
                            {% set missing = translations.getMissingCount(source, locale) %}
                            <td>
                                {% if missing == 0 %}
                                    <span class="success">{{ "Complete"|t('translator-pro') }}</span>
                                {% else %}
                                    <span class="light">{{ "{n} missing"|t('translator-pro', { n: missing }) }}</span>
                                {% endif %}
                            </td>
                        {% endfor %}
                        <td class="thin">
                            <a class="btn small" href="{{ source.cpEditUrl }}">{{ "Edit"|t('translator-pro') }}</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <h2 style="margin-top: 32px;">{{ "Scanned for template strings"|t('translator-pro') }}</h2>
    <ul class="light">
        {% for path in scanPaths %}
            <li><code>{{ path }}</code></li>
        {% else %}
            <li>{{ "No scannable directories were found."|t('translator-pro') }}</li>
        {% endfor %}
    </ul>
{% endblock %}
