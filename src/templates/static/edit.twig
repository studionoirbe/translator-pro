{% extends "_layouts/cp" %}
{% import "_includes/forms.twig" as forms %}

{% set selectedSubnavItem = 'static' %}
{% set title = source.name %}
{% set crumbs = [
    { label: "Static translations"|t('translator-pro'), url: url('translator-pro/static') },
] %}

{% set baseUrl = url('translator-pro/static/' ~ source.category) %}
{% set currentUrl = 'translator-pro/static/' ~ source.category ~ '?locale=' ~ locale ~ '&filter=' ~ filter ~ '&search=' ~ search|url_encode ~ '&page=' ~ page %}

{% block content %}
    <form method="get" action="{{ baseUrl }}" class="tp-toolbar">
        {{ forms.selectField({
            label: "Language"|t('translator-pro'),
            name: 'locale',
            options: locales,
            value: locale,
            inputAttributes: { onchange: 'this.form.submit()' },
        }) }}

        {{ forms.selectField({
            label: "Show"|t('translator-pro'),
            name: 'filter',
            options: {
                all: "All"|t('translator-pro'),
                missing: "Missing only"|t('translator-pro'),
                translated: "Translated only"|t('translator-pro'),
            },
            value: filter,
            inputAttributes: { onchange: 'this.form.submit()' },
        }) }}

        {# Input and button share one field so the button sits right beside
           the box rather than floating in a column of its own. #}
        <div class="field tp-search-field">
            <div class="heading">
                <label for="tp-search">{{ "Search"|t('translator-pro') }}</label>
            </div>
            <div class="input tp-search-input">
                <input
                    type="text"
                    id="tp-search"
                    class="text fullwidth"
                    name="search"
                    value="{{ search }}"
                    placeholder="{{ "Source or translation"|t('translator-pro') }}"
                >
                <button type="submit" class="btn">{{ "Search"|t('translator-pro') }}</button>
            </div>
    </div>
    </form>

    <p class="light">
        {{ "{total} strings shown · {missing} missing in {locale} · saved to"|t('translator-pro', {
            total: total,
            missing: missingCount,
            locale: locale,
        }) }}
        <code>translations/{{ locale }}/{{ source.category }}.php</code>
    </p>

    {% if canUseAi and missingCount > 0 %}
        <form method="post" accept-charset="UTF-8" style="margin-bottom: 18px;">
            {{ csrfInput() }}
            {{ actionInput('translator-pro/static/translate-missing') }}
            {{ redirectInput(currentUrl) }}
            {{ hiddenInput('category', source.category) }}
            {{ hiddenInput('locale', locale) }}
            <button type="submit" class="btn submit">
                {{ "Translate {n} missing strings with AI"|t('translator-pro', { n: missingCount }) }}
            </button>
        </form>
    {% endif %}

    <form method="post" accept-charset="UTF-8" data-saveshortcut>
        {{ csrfInput() }}
        {{ actionInput('translator-pro/static/save') }}
        {{ redirectInput(currentUrl) }}
        {{ hiddenInput('category', source.category) }}
        {{ hiddenInput('locale', locale) }}

        <p class="light smalltext" style="margin-bottom: 8px;">
            {{ "Fields already holding a translation shipped with this source are marked “default”. Edit one to override it for this project; only what you change is written to the translation file."|t('translator-pro') }}
        </p>

        {# Captured once, rendered above and below the table: on a 50-row page the
           bottom Save is a long way from the first field you edited. #}
        {% set pageUrl = baseUrl ~ '?locale=' ~ locale ~ '&filter=' ~ filter ~ '&search=' ~ search|url_encode ~ '&page=' %}
        {% set actionsBar %}
            <div class="tp-actions">
                {% if totalPages > 1 %}
                    <nav class="tp-pagination" aria-label="{{ "Pagination"|t('translator-pro') }}">
                        <a
                            class="btn{% if page <= 1 %} disabled{% endif %}"
                            {% if page > 1 %}href="{{ pageUrl ~ (page - 1) }}"{% else %}aria-disabled="true"{% endif %}
                        >{{ "Previous"|t('translator-pro') }}</a>

                        <span class="light">{{ "Page {page} of {total}"|t('translator-pro', { page: page, total: totalPages }) }}</span>

                        <a
                            class="btn{% if page >= totalPages %} disabled{% endif %}"
                            {% if page < totalPages %}href="{{ pageUrl ~ (page + 1) }}"{% else %}aria-disabled="true"{% endif %}
                        >{{ "Next"|t('translator-pro') }}</a>
                    </nav>
                {% else %}
                    <span></span>
                {% endif %}

                <button type="submit" class="btn submit">{{ "Save"|t('translator-pro') }}</button>
            </div>
        {% endset %}

        {% if rows is empty %}
            <p>{{ "No strings match that filter."|t('translator-pro') }}</p>
        {% else %}
            {{ actionsBar|raw }}

            <table class="data fullwidth tp-table tp-compact">
                {# With table-layout:fixed the column widths come from the first
                   row, so they're declared here rather than on the cells. #}
                <colgroup>
                    <col class="tp-col-source">
                    <col class="tp-col-translation">
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col" class="tp-col-source">{{ "Source string"|t('translator-pro') }}</th>
                        <th scope="col" class="tp-col-translation">{{ locales[locale] }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        {# base64url so the key survives PHP's form-name parsing intact #}
                        {% set encodedKey = row.key|base64_encode|replace({'+': '-', '/': '_'}) %}
                        <tr>
                            {# Whitespace is trimmed on purpose: the cell keeps the
                               source string's own leading and trailing spaces. #}
                            <td class="tp-source-string">
                                {%- if row.source matches '/^\\s|\\s$/' -%}
                                    <code class="tp-whitespace" title="{{ "This string begins or ends with a space"|t('translator-pro') }}">{{- row.source -}}</code>
                                {%- else -%}
                                    <code>{{- row.source -}}</code>
                                {%- endif -%}
                                {%- if row.source != row.key %}
                                    <div class="light smalltext">{{ "Key"|t('translator-pro') }}: {{ row.key }}</div>
                                {% endif -%}
                            </td>
                            <td class="tp-translation-cell">
                                <div class="tp-translation-row">
                                    <span class="tp-row-status">
                                        {%- if row.isOverridden -%}
                                            <button
                                                type="button"
                                                class="delete icon js-tp-delete"
                                                title="{{ row.shipped
                                                    ? "Reset to the translation this plugin ships"|t('translator-pro')
                                                    : "Delete this translation"|t('translator-pro') }}"
                                                data-key="{{ row.key }}"
                                            ></button>
                                        {%- elseif row.translation -%}
                                            <span class="tp-badge" title="{{ "Shipped with the source. Edit it to create a project override."|t('translator-pro') }}">
                                                {{- "default"|t('translator-pro') -}}
                                            </span>
                                        {%- endif -%}
                                    </span>
                                    <textarea
                                        class="text tp-translation-input{% if not row.isOverridden and row.translation %} tp-inherited{% endif %}"
                                        rows="1"
                                        name="translations[{{ encodedKey }}]"
                                        data-translator-pro-skip
                                        dir="{{ locale starts with 'ar' or locale starts with 'he' ? 'rtl' : 'ltr' }}"
                                    >{{ row.translation }}</textarea>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {{ actionsBar|raw }}
        {% endif %}
    </form>

    <hr>

    <h2>{{ "Add a translation"|t('translator-pro') }}</h2>
    <p class="light">
        {{ "Add a string that isn’t in the source files yet — handy for copy you’re about to write, or a plugin string Craft hasn’t emitted."|t('translator-pro') }}
    </p>

    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('translator-pro/static/add-string') }}
        {{ redirectInput(currentUrl) }}
        {{ hiddenInput('category', source.category) }}
        {{ hiddenInput('locale', locale) }}

        {{ forms.textField({
            label: "Source string"|t('translator-pro'),
            instructions: "Exactly what is passed to |t or Craft::t()."|t('translator-pro'),
            name: 'key',
            required: true,
        }) }}

        {{ forms.textField({
            label: "Translation"|t('translator-pro') ~ ' (' ~ locale ~ ')',
            name: 'value',
        }) }}

        <div class="buttons">
            <button type="submit" class="btn submit">{{ "Add"|t('translator-pro') }}</button>
        </div>
    </form>
{% endblock %}

{% js %}
document.querySelectorAll('.js-tp-delete').forEach(function (button) {
    button.addEventListener('click', function () {
        if (!confirm({{ "Delete this translation in every language?"|t('translator-pro')|json_encode|raw }})) {
            return;
        }

        Craft.sendActionRequest('POST', 'translator-pro/static/delete-string', {
            data: {
                category: {{ source.category|json_encode|raw }},
                key: button.dataset.key
            }
        }).then(function () {
            button.closest('tr').remove();
            Craft.cp.displayNotice({{ "String deleted."|t('translator-pro')|json_encode|raw }});
        }).catch(function () {
            Craft.cp.displayError({{ "Couldn’t delete that string."|t('translator-pro')|json_encode|raw }});
        });
    });
});
{% endjs %}
